# Exclude everything by default
/*

# Except for tracked top-level project directories
!/.devcontainer/
!/.github/
!/.github-assets/
!/docs/
!/targets/
!/scripts/
!/subprojects/
/subprojects/*
!/subprojects/stb.wrap
!/subprojects/zlib.wrap
!/subprojects/miniaudio.wrap
!/subprojects/sdl2.wrap
!/subprojects/glm.wrap
!/subprojects/glew.wrap
!/subprojects/shiggy.wrap
!/subprojects/simdutf.wrap
!/subprojects/bgfx.wrap
!/subprojects/packagefiles
/scripts/__pycache__/
!/.clang-format
!/.git-blame-ignore-revs
!/.gitattributes
!/.gitignore
!/.gitmodules
!/CONTRIBUTING.md
!/flake.nix
!/meson.build
!/meson.options
!/README.md
